{
  "name": "beauty-catalog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "prisma generate && tsc -b && vite build && tsc -p tsconfig.server.json",
    "build:vercel": "prisma migrate deploy && npm run build",
    "typecheck": "prisma generate && tsc -b && tsc -p tsconfig.server.json --noEmit",
    "lint": "oxlint client server shared api tests",
    "start": "node dist-server/server/index.js",
    "db:migrate": "prisma migrate deploy",
    "admin:create": "tsx server/create-admin.ts",
    "db:seed": "tsx server/seed.ts",
    "events:cleanup": "tsx server/cleanup-events.ts",
    "test": "prisma generate && tsc -p tsconfig.server.json && tsx --test tests/integration.test.ts tests/whatsapp.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "embedded-postgres": "^18.6.0-beta.19",
    "oxlint": "^1.92.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
