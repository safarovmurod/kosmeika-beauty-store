{
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/server.mjs": {
      "includeFiles": "{dist/index.html,dist-server/**}",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "/api/server"
    },
    {
      "src": "^/uploads/(.*)$",
      "dest": "/api/server"
    },
    {
      "src": "^/$",
      "dest": "/api/server"
    },
    {
      "src": "^/robots\\.txt$",
      "dest": "/api/server"
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/api/server"
    },
    {
      "src": "^/admin(?:/.*)?$",
      "dest": "/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "no-store"
      }
    },
    {
      "handle": "filesystem"
    }
  ]
}
