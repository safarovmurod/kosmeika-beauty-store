{
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/server.mjs": {
      "includeFiles": "{dist/index.html,dist-server/**}",
      "maxDuration": 60
    }
  },
  "headers": [
    { "source": "/admin/:path*", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Cache-Control", "value": "no-store" }
    ] }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/server" },
    { "source": "/uploads/:path*", "destination": "/api/server" },
    { "source": "/", "destination": "/api/server" },
    { "source": "/robots.txt", "destination": "/api/server" },
    { "source": "/sitemap.xml", "destination": "/api/server" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
